# ---- Required ---------------------------------------------------------------
# Claude powers parsing, generation, vision extraction, and the doubt chatbot.
ANTHROPIC_API_KEY=

# Supabase project (Settings -> API). The service key bypasses RLS and must
# never be exposed to the browser — it is only ever read by this API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Optional: each unlocks one feature, none block the core pipeline -------
# Embeddings for pgvector retrieval. Without it the chatbot uses keyword search.
VOYAGE_API_KEY=

# Resource aggregator. Set either one; Tavily is preferred when both are set.
TAVILY_API_KEY=
SERPER_API_KEY=

# WhatsApp revision alerts (Twilio WhatsApp Sandbox works for the demo).
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# ---- Deployment -------------------------------------------------------------
# Origins allowed to call this API. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Where the React client is served. Used to build PDF chat links and alert links.
PUBLIC_APP_URL=http://localhost:5173

# Shared secret for /api/jobs/run and /api/alerts/send. Leave blank locally;
# always set it in a deployed environment.
WORKER_SECRET=

# Used by the local worker script to reach this API.
WORKER_API_URL=http://localhost:4000
